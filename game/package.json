{
  "name": "mossy-meadows",
  "private": true,
  "version": "1.8.4",
  "description": "Mossy Meadows - cozy 2.5D farm & exploration game for mobile",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "android": "../android/build.sh",
    "models:check": "node tools/check-models.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
